# Public Supabase client settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Supabase access
SUPABASE_SERVICE_ROLE_KEY=
OWNER_USER_ID=
OWNER_EMAIL=

# Provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Live research
TAVILY_API_KEY=

# Optional OCR for scanned/image-only PDFs
OCR_SPACE_API_KEY=

# Owner/self-improvement controls
SV_OWNER_PASSWORD=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# Backend/internal service coordination
SVANSAI_API_KEY=
SVANSAI_INTERNAL_API_KEY=
SVANSAI_CORS_ORIGINS=
# Exact, comma-separated browser origins for this app behind a reverse proxy.
# No wildcards or paths. Separate from API CORS; never populated from request headers.
# Example: https://svansai.com,https://svansai-frontend.onrender.com
# Leave blank for direct local same-origin requests without a reverse proxy.
SVANSAI_APP_ORIGINS=

# Optional local regression user. Do not commit real credentials.
SVANSAI_TEST_EMAIL=
SVANSAI_TEST_PASSWORD=

# Cyber integration: SOURCE ONLY, disabled until the separate acceptance pass.
# Prefer scrypt$<hex salt of at least 16 bytes>$<64-byte derived key in hex>.
# SV_OWNER_PASSWORD_HASH takes precedence over legacy SV_OWNER_PASSWORD.
SV_OWNER_PASSWORD_HASH=
SVANSAI_ADMIN_CYBER_MODE_ENABLED=0
SVANSAI_CYBER_EXECUTION_ENABLED=0
SVANSAI_CYBER_SCANNER_IMAGE=
SVANSAI_CYBER_FIXTURE_IMAGE=
# No adjustable fixed-duration expiry. Genuine owner activity extends the
# server-validated 30-minute idle deadline; jobs/polling never extend it.
# Existing generation/immutable-file systems must also be configured:
SVANSAI_JOBS_ENABLED=0
SVANSAI_ARTIFACT_STORAGE_ENABLED=0
